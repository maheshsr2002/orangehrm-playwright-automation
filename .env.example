# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your confidential values
# ==============================================================================

BASE_URL=https://opensource-demo.orangehrmlive.com

# Confidential Credentials (provide in .env only, never commit)
ADMIN_USERNAME=your_username_here
ADMIN_PASSWORD=your_password_here

# Browser Settings (chromium, firefox, webkit)
BROWSER=chromium
HEADLESS=true
SLOW_MO=0

# Timeouts in milliseconds
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=45000

# Reporting
SCREENSHOT_ON_FAILURE=true
VIDEO_RECORDING=retain-on-failure
